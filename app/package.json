{
  "name": "@sleep-tracker/app",
  "version": "0.1.0",
  "private": true,
  "description": "Sleep Tracker: web app (PWA) Next.js",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
