# Esempio di variabili d'ambiente (NON mettere valori reali nel repo: vanno in env Vercel).
# Obbligatorie
GATEWAY_SECRET=               # bearer condiviso app <-> gateway, >= 16 caratteri (consigliati 32+ casuali)
GROQ_API_KEY=                 # provider principale (senza: solo insight a regole, chat -> 503)
# Opzionali
# OPENROUTER_API_KEY=         # attiva i due modelli OpenRouter :free
# MISTRAL_API_KEY=            # provider disattivato (piano a pagamento)
# GATEWAY_PROVIDERS_JSON=     # override/aggiunte, vedi docs/AI_GATEWAY.md
# GATEWAY_RATE_LIMIT_RPM=60
# GATEWAY_LOG=off             # disattiva tutti i log
# Log metadati su Supabase: OPT-IN, attivi solo se ENTRAMBE sono impostate (altrimenti solo console)
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# Solo per npm run dev:server
# PORT=8787
